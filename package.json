{
  "name": "bo-coffee",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "validate:content": "node scripts/build-content.mjs",
    "content": "node scripts/build-content.mjs",
    "prestart": "node scripts/build-content.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "new-post": "node scripts/new-post.mjs",
    "news": "node scripts/coffee-news/index.mjs",
    "news:dry": "node scripts/coffee-news/index.mjs --dry-run",
    "test:ci": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.8",
    "@angular/cli": "^22.2.8",
    "@angular/compiler-cli": "^22.2.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^31.0.1",
    "linkedom": "^0.18.15",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  },
  "description": "Bo Coffee — a bilingual (VI/EN) coffee notebook: knowledge articles, interactive brew tools, a personal bean shelf and brew log"
}
